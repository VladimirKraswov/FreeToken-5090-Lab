 import asyncio
 import time
 
+_MISSING = object()
+
+
+class _Load:
+    """State shared by all waiters of one load for one key/generation."""
+
+    __slots__ = ("generation", "result", "error", "settled", "waiters")
+
+    def __init__(self, generation):
+        self.generation = generation
+        self.result = None
+        self.error = None
+        self.settled = False
+        self.waiters = set()
+
+    def settle(self, result=None, error=None):
+        self.settled = True
+        self.result = result
+        self.error = error
+        for fut in tuple(self.waiters):
+            self.waiters.discard(fut)
+            if fut.done():
+                continue
+            if error is None:
+                fut.set_result(result)
+            else:
+                fut.set_exception(error)
+
+
 class AsyncCache:
+    """Single-event-loop async cache with TTL and in-flight coalescing.
+
+    - Concurrent callers for one key share exactly one loader run.
+    - A waiter's cancellation never cancels the shared loader.
+    - TTL starts at successful completion; entry expires when clock >= expiry.
+    - None is a cacheable value; loader failures are never cached.
+    - clear() invalidates stored values and in-flight ownership: loads from a
+      previous generation may still return to their own waiters, but can
+      neither write nor remove anything belonging to a newer generation.
+    """
+
     def __init__(self, ttl, clock=time.monotonic):
         self.ttl = ttl
         self.clock = clock
         self.values = {}
         self.pending = {}
+        self._generation = 0
 
     async def get(self, key, loader):
