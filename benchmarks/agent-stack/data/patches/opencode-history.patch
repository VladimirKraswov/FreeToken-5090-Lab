diff --git a/tests/regression.test.mjs b/tests/regression.test.mjs
new file mode 100644
index 0000000..b767172
--- /dev/null
+++ b/tests/regression.test.mjs
@@ -0,0 +1,139 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { GestureHistory } from '../history.mjs';
+
+test('begin while any gesture is active returns false, even for same pointer', () => {
+  const h = new GestureHistory({x: 0});
+  assert.equal(h.begin(1), true);
+  assert.equal(h.begin(1), false);
+  assert.equal(h.begin(2), false);
+  assert.equal(h.commit(1), true);
+  assert.equal(h.begin(1), true);
+});
+
+test('foreign update, commit and cancel return false and never steal ownership', () => {
+  const h = new GestureHistory({x: 0});
+  assert.equal(h.update(9, {x: 5}), false);
+  assert.equal(h.commit(9), false);
+  assert.equal(h.cancel(9), false);
+  assert.deepEqual(h.state, {x: 0});
+
+  h.begin(1);
+  h.update(1, {x: 4});
+  assert.equal(h.update(2, {x: 9}), false);
+  assert.equal(h.commit(2), false);
+  assert.equal(h.cancel(2), false);
+  assert.deepEqual(h.state, {x: 4});
+  assert.equal(h.commit(1), true);
+  assert.deepEqual(h.state, {x: 4});
+});
+
+test('unchanged commit returns true, adds no undo step and preserves redo', () => {
+  const h = new GestureHistory({x: 0});
+  h.begin(1); h.update(1, {x: 1}); h.commit(1);
+  assert.equal(h.undo(), true);
+  assert.equal(h.begin(2), true);
+  assert.equal(h.commit(2), true);
+  assert.equal(h.redo(), true);
+  assert.deepEqual(h.state, {x: 1});
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, {x: 0});
+  assert.equal(h.undo(), false);
+});
+
+test('changed commit saves exactly one undo step and clears redo', () => {
+  const h = new GestureHistory({x: 0});
+  h.begin(1);
+  h.update(1, {x: 1});
+  h.update(1, {x: 2});
+  h.update(1, {x: 3});
+  h.commit(1);
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, {x: 0});
+  assert.equal(h.undo(), false);
+
+  h.redo();
+  h.begin(1); h.update(1, {x: 7}); h.commit(1);
+  assert.equal(h.redo(), false);
+});
+
+test('cancel restores starting state, preserves redo and requires matching pointer', () => {
+  const h = new GestureHistory({x: 0});
+  h.begin(1); h.update(1, {x: 2}); h.commit(1);
+  assert.equal(h.undo(), true);
+  assert.equal(h.begin(1), true);
+  h.update(1, {x: 8});
+  assert.equal(h.cancel(2), false);
+  assert.deepEqual(h.state, {x: 8});
+  assert.equal(h.cancel(1), true);
+  assert.deepEqual(h.state, {x: 0});
+  assert.equal(h.redo(), true);
+  assert.deepEqual(h.state, {x: 2});
+});
+
+test('undo and redo while dragging return false and leave the live gesture intact', () => {
+  const h = new GestureHistory({x: 0});
+  h.begin(1); h.update(1, {x: 1}); h.commit(1);
+  h.begin(1); h.update(1, {x: 5});
+  assert.equal(h.undo(), false);
+  assert.deepEqual(h.state, {x: 5});
+  assert.equal(h.redo(), false);
+  assert.deepEqual(h.state, {x: 5});
+  assert.equal(h.commit(1), true);
+  assert.deepEqual(h.state, {x: 5});
+});
+
+test('no-op undo and redo return false', () => {
+  const h = new GestureHistory({x: 0});
+  assert.equal(h.undo(), false);
+  assert.equal(h.redo(), false);
+});
+
+test('inputs and returned state are defensively copied including nested structures', () => {
+  const initial = {points: [{x: 0}], meta: {tag: 'a'}};
+  const h = new GestureHistory(initial);
+  initial.points[0].x = 99;
+  initial.meta.tag = 'mutated';
+  assert.deepEqual(h.state, {points: [{x: 0}], meta: {tag: 'a'}});
+
+  const next = {points: [{x: 1}], meta: {tag: 'b'}};
+  h.begin(1);
+  assert.equal(h.update(1, next), true);
+  next.points[0].x = 42;
+  assert.deepEqual(h.state, {points: [{x: 1}], meta: {tag: 'b'}});
+  h.commit(1);
+
+  const snapshot = h.state;
+  snapshot.points[0].x = -1;
+  snapshot.extra = true;
+  assert.deepEqual(h.state, {points: [{x: 1}], meta: {tag: 'b'}});
+
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, {points: [{x: 0}], meta: {tag: 'a'}});
+});
+
+test('structural equality ignores object key order', () => {
+  const h = new GestureHistory({a: 1, b: {c: 2, d: [3]}});
+  h.begin(1);
+  h.update(1, {b: {d: [3], c: 2}, a: 1});
+  assert.equal(h.commit(1), true);
+  assert.equal(h.undo(), false);
+});
+
+test('structural equality respects array order and nested changes', () => {
+  const h = new GestureHistory({pts: [1, 2, 3]});
+  h.begin(1);
+  h.update(1, {pts: [3, 2, 1]});
+  assert.equal(h.commit(1), true);
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, {pts: [1, 2, 3]});
+});
+
+test('structural equality distinguishes missing keys from null', () => {
+  const h = new GestureHistory({a: 1, b: null});
+  h.begin(1);
+  h.update(1, {a: 1});
+  assert.equal(h.commit(1), true);
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, {a: 1, b: null});
+});
