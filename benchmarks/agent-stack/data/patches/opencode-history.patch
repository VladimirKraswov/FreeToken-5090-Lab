+function isPlainObject(value) {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function deepClone(value) {
+  if (Array.isArray(value)) return value.map(deepClone);
+  if (isPlainObject(value)) {
+    const copy = {};
+    for (const key of Object.keys(value)) copy[key] = deepClone(value[key]);
+    return copy;
+  }
+  return value;
+}
+
+function deepEqual(a, b) {
+  if (a === b) return true;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    return a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isPlainObject(a) && isPlainObject(b)) {
+    const keysA = Object.keys(a);
+    const keysB = Object.keys(b);
+    if (keysA.length !== keysB.length) return false;
+    return keysA.every((key) =>
+      Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]));
+  }
+  return false;
+}
+
 export class GestureHistory {
-  constructor(initial) { this.current = initial; this.past = []; this.future = []; this.active = null; }
-  get state() { return this.current; }
-  begin(pointerId) { this.active = { pointerId, start: this.current }; return true; }
-  update(pointerId, next) { if (!this.active) return false; this.current = next; return true; }
+  constructor(initial) {
+    this.current = deepClone(initial);
+    this.past = [];
+    this.future = [];
+    this.active = null;
+  }
+
+  get state() { return deepClone(this.current); }
+
+  begin(pointerId) {
+    if (this.active) return false;
+    this.active = { pointerId, start: deepClone(this.current) };
+    return true;
+  }
+
+  update(pointerId, next) {
+    if (!this.active || pointerId !== this.active.pointerId) return false;
+    this.current = deepClone(next);
+    return true;
+  }
+
   commit(pointerId) {
-    if (!this.active) return false;
-    this.past.push(this.active.start); this.future = []; this.active = null; return true;
+    if (!this.active || pointerId !== this.active.pointerId) return false;
+    if (!deepEqual(this.current, this.active.start)) {
+      this.past.push(this.active.start);
+      this.future = [];
+    }
+    this.active = null;
+    return true;
+  }
+
+  cancel(pointerId) {
+    if (!this.active || pointerId !== this.active.pointerId) return false;
+    this.current = this.active.start;
+    this.active = null;
+    return true;
+  }
+
+  undo() {
+    if (this.active || this.past.length === 0) return false;
+    this.future.push(this.current);
+    this.current = this.past.pop();
+    return true;
+  }
+
+  redo() {
+    if (this.active || this.future.length === 0) return false;
+    this.past.push(this.current);
+    this.current = this.future.pop();
+    return true;
   }
-  cancel(pointerId) { if (!this.active) return false; this.current = this.active.start; this.active = null; return true; }
