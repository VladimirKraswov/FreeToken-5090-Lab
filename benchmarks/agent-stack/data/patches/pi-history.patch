-  get state() { return this.current; }
-  begin(pointerId) { this.active = { pointerId, start: this.current }; return true; }
-  update(pointerId, next) { if (!this.active) return false; this.current = next; return true; }
+  constructor(initial) {
+    this.current = copy(initial);
+    this.past = [];
+    this.future = [];
+    this.active = null;
+  }
+
+  get state() {
+    return copy(this.current);
+  }
+
+  // One gesture at a time; a second begin (any pointer) is rejected.
+  begin(pointerId) {
+    if (this.active) return false;
+    this.active = { pointerId, start: copy(this.current) };
+    return true;
+  }
+
+  update(pointerId, next) {
+    if (!this.active || this.active.pointerId !== pointerId) return false;
+    this.current = copy(next);
+    return true;
+  }
+
   commit(pointerId) {
-    if (!this.active) return false;
-    this.past.push(this.active.start); this.future = []; this.active = null; return true;
+    if (!this.active || this.active.pointerId !== pointerId) return false;
+    const changed = !deepEqual(this.current, this.active.start);
+    if (changed) {
+      this.past.push(this.active.start);
+      this.future = [];
+    }
+    this.active = null;
+    return true;
+  }
+
+  cancel(pointerId) {
+    if (!this.active || this.active.pointerId !== pointerId) return false;
+    this.current = this.active.start;
+    this.active = null;
+    return true;
+  }
+
+  undo() {
+    if (this.active || this.past.length === 0) return false;
+    this.future.push(this.current);
+    this.current = this.past.pop();
+    return true;
+  }
+
+  redo() {
