+// Dependency-free gesture history for a pointer-based geometry editor.
+// State documents are JSON-like (plain objects, arrays, primitives).
+
+function isPlainObject(value) {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Deep copy of JSON-like documents; primitives (and null) pass through.
+function copy(value) {
+  if (Array.isArray(value)) return value.map(copy);
+  if (isPlainObject(value)) {
+    const out = {};
+    for (const key of Object.keys(value)) out[key] = copy(value[key]);
+    return out;
+  }
+  return value;
+}
+
+// Structural equality: object key order is irrelevant, array order matters,
+// a missing key is different from a key holding null.
+function deepEqual(a, b) {
+  if (a === b) return true;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) if (!deepEqual(a[i], b[i])) return false;
+    return true;
+  }
+  if (isPlainObject(a) && isPlainObject(b)) {
+    if (a === null || b === null) return a === b;
+    const keysA = Object.keys(a);
+    const keysB = Object.keys(b);
+    if (keysA.length !== keysB.length) return false;
+    for (const key of keysA) {
+      if (!Object.prototype.hasOwnProperty.call(b, key)) return false;
+      if (!deepEqual(a[key], b[key])) return false;
+    }
+    return true;
+  }
+  return false;
+}
+
