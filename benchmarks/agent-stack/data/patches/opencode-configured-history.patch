diff --git a/tests/regression.test.mjs b/tests/regression.test.mjs
new file mode 100644
index 0000000..f0f14e3
--- /dev/null
+++ b/tests/regression.test.mjs
@@ -0,0 +1,140 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { GestureHistory } from '../history.mjs';
+
+test('begin is rejected while any gesture is active', () => {
+  const h = new GestureHistory({ x: 0 });
+  assert.equal(h.begin(1), true);
+  assert.equal(h.begin(2), false);
+  assert.equal(h.begin(1), false);
+  assert.equal(h.commit(1), true);
+  assert.equal(h.begin(2), true);
+});
+
+test('foreign pointers cannot update, commit or cancel an active gesture', () => {
+  const h = new GestureHistory({ x: 0 });
+  h.begin(1);
+  assert.equal(h.update(2, { x: 9 }), false);
+  assert.deepEqual(h.state, { x: 0 });
+  assert.equal(h.commit(2), false);
+  assert.equal(h.cancel(2), false);
+  // Gesture must still be owned by pointer 1 and behave normally.
+  assert.equal(h.update(1, { x: 4 }), true);
+  assert.deepEqual(h.state, { x: 4 });
+  assert.equal(h.commit(1), true);
+  assert.deepEqual(h.state, { x: 4 });
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, { x: 0 });
+});
+
+test('idle update/commit/cancel return false', () => {
+  const h = new GestureHistory({ x: 0 });
+  assert.equal(h.update(1, { x: 5 }), false);
+  assert.equal(h.commit(1), false);
+  assert.equal(h.cancel(1), false);
+  assert.deepEqual(h.state, { x: 0 });
+});
+
+test('whole changed gesture saves exactly one undo step', () => {
+  const h = new GestureHistory({ n: 0 });
+  h.begin(7);
+  h.update(7, { n: 1 });
+  h.update(7, { n: 2 });
+  h.update(7, { n: 3 });
+  h.commit(7);
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, { n: 0 });
+  assert.equal(h.undo(), false);
+});
+
+test('unchanged commit returns true, saves no step and preserves redo', () => {
+  const h = new GestureHistory({ a: 1, b: [1, 2] });
+  h.begin(1); h.update(1, { a: 2 }); h.commit(1);
+  h.undo(); // redo stack now holds {a:2}
+  h.begin(1);
+  h.update(1, { b: [1, 2], a: 1 }); // same document, different key order
+  assert.equal(h.commit(1), true);
+  assert.equal(h.redo(), true); // redo survived the unchanged commit
+  assert.deepEqual(h.state, { a: 2 });
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, { a: 1, b: [1, 2] });
+  assert.equal(h.undo(), false); // unchanged commit pushed no extra step
+});
+
+test('changed commit clears the redo stack', () => {
+  const h = new GestureHistory({ v: 'a' });
+  h.begin(1); h.update(1, { v: 'b' }); h.commit(1);
+  h.undo();
+  h.begin(1); h.update(1, { v: 'c' }); h.commit(1);
+  assert.equal(h.redo(), false);
+  assert.deepEqual(h.state, { v: 'c' });
+});
+
+test('cancel restores the starting state and preserves redo', () => {
+  const h = new GestureHistory({ s: 0 });
+  h.begin(1); h.update(1, { s: 1 }); h.commit(1);
+  h.undo(); // future: [{s:1}]
+  h.begin(1);
+  h.update(1, { s: 99 });
+  assert.deepEqual(h.state, { s: 99 });
+  assert.equal(h.cancel(1), true);
+  assert.deepEqual(h.state, { s: 0 });
+  assert.equal(h.redo(), true); // cancel preserved the redo stack
+  assert.deepEqual(h.state, { s: 1 });
+  assert.equal(h.cancel(1), false); // gesture already ended
+});
+
+test('undo/redo while dragging are refused and leave the live gesture intact', () => {
+  const h = new GestureHistory({ z: 0 });
+  h.begin(1); h.update(1, { z: 1 });
+  assert.equal(h.undo(), false);
+  assert.equal(h.redo(), false);
+  assert.deepEqual(h.state, { z: 1 }); // live preview untouched
+  assert.equal(h.commit(1), true);
+  assert.deepEqual(h.state, { z: 1 });
+});
+
+test('no-op undo/redo return false', () => {
+  const h = new GestureHistory({});
+  assert.equal(h.undo(), false);
+  assert.equal(h.redo(), false);
+});
+
+test('inputs and returned state are deep-copied defensively', () => {
+  const initial = { pts: [{ x: 1 }], meta: { tag: 't' } };
+  const h = new GestureHistory(initial);
+  initial.pts[0].x = 99;
+  initial.meta.tag = 'mutated';
+  assert.deepEqual(h.state, { pts: [{ x: 1 }], meta: { tag: 't' } });
+
+  const snapshot = h.state;
+  snapshot.pts[0].x = 7;
+  snapshot.newKey = 'evil';
+  assert.deepEqual(h.state, { pts: [{ x: 1 }], meta: { tag: 't' } });
+
+  const next = { pts: [{ x: 2 }] };
+  h.begin(1);
+  assert.equal(h.update(1, next), true);
+  next.pts[0].x = 8;
+  assert.deepEqual(h.state, { pts: [{ x: 2 }] });
+  h.commit(1);
+  // History-internal documents must not leak references either.
+  h.undo();
+  assert.deepEqual(h.state, { pts: [{ x: 1 }], meta: { tag: 't' } });
+  h.state.pts[0].x = 55;
+  assert.deepEqual(h.state, { pts: [{ x: 1 }], meta: { tag: 't' } });
+});
+
+test('structural equality respects array order and null vs missing key', () => {
+  const h = new GestureHistory({ list: [1, 2] });
+  h.begin(1); h.update(1, { list: [2, 1] }); h.commit(1); // order matters: changed
+  assert.equal(h.undo(), true);
+  assert.deepEqual(h.state, { list: [1, 2] });
+  assert.equal(h.redo(), true);
+
+  const g = new GestureHistory({ a: null });
+  g.begin(1); g.update(1, {}); // missing key vs null: changed
+  g.commit(1);
+  assert.equal(g.undo(), true);
+  assert.deepEqual(g.state, { a: null });
+});
