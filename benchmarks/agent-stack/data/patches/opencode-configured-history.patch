+const isObject = (v) => v !== null && typeof v === 'object';
+
+const deepClone = (v) => {
+  if (Array.isArray(v)) return v.map(deepClone);
+  if (isObject(v)) {
+    const out = {};
+    for (const key of Object.keys(v)) out[key] = deepClone(v[key]);
+    return out;
+  }
+  return v;
+};
+
+// Structural equality: ignores object key order, respects array order,
+// distinguishes a missing key from an explicit null.
+const deepEqual = (a, b) => {
+  if (a === b) return true;
+  if (!isObject(a) || !isObject(b)) return Object.is(a, b);
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  const keysA = Object.keys(a);
+  const keysB = Object.keys(b);
+  if (keysA.length !== keysB.length) return false;
+  for (const key of keysA) {
+    if (!Object.prototype.hasOwnProperty.call(b, key)) return false;
+    if (!deepEqual(a[key], b[key])) return false;
+  }
+  return true;
+};
