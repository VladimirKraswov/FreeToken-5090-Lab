+    this.current = copy(initial);
+    this.past = [];
+    this.future = [];
+    this.active = null;
+  }
+
+  get state() {
+    return copy(this.current);
+  }
+
+  begin(pointerId) {
+    if (this.active !== null) return false;
+    this.active = { pointerId, start: copy(this.current) };
+    return true;
+  }
+
+  update(pointerId, next) {
+    if (this.active === null || this.active.pointerId !== pointerId) return false;
+    this.current = copy(next);
