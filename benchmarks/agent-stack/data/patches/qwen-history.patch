+  }
+
   commit(pointerId) {
-    if (!this.active) return false;
-    this.past.push(this.active.start); this.future = []; this.active = null; return true;
+    if (this.active === null || this.active.pointerId !== pointerId) return false;
+    const start = this.active.start;
+    this.active = null;
+    if (same(start, this.current)) return true;
+    this.past.push(start);
+    this.future = [];
+    return true;
+  }
+
+  cancel(pointerId) {
+    if (this.active === null || this.active.pointerId !== pointerId) return false;
