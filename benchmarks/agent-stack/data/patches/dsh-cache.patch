 import asyncio
 import time
 
+_MISSING = object()
+
+
 class AsyncCache:
+    """Single-event-loop TTL cache with per-key load coalescing.
+
+    Public API: ``AsyncCache(ttl, clock=time.monotonic)``,
+    ``await get(key, loader)``, ``clear()``.
+
+    Guarantees (see README):
+    - Values, including ``None``, are cached; a hit requires ``clock() < expiry``
+      (the entry expires once ``clock() >= expiry``).
+    - TTL is measured from *successful completion* of the loader.
+    - Loader failures are reported to every waiter and never cached.
+    - Concurrent callers for one key share exactly one load; different keys
+      never wait on each other. No locks are held across awaits.
+    - A waiter is shielded from the shared task, so cancelling a caller (even
+      the last one) never cancels the in-flight loader.
+    - ``clear()`` drops stored values *and* in-flight ownership: existing
+      waiters keep their shielded task and may still receive the old result,
+      but later callers start a fresh load and a detached (old-generation)
+      load can neither overwrite nor remove newer cache state.
+    """
+
     def __init__(self, ttl, clock=time.monotonic):
         self.ttl = ttl
         self.clock = clock
-        self.values = {}
-        self.pending = {}
+        self.values = {}    # key -> (value, expiry)
+        self.pending = {}   # key -> loader task still owned by the cache
 
     async def get(self, key, loader):
-        value, expiry = self.values.get(key, (None, 0))
-        if value is not None and self.clock() < expiry:
-            return value
-        if key not in self.pending:
-            async def load():
-                expiry = self.clock() + self.ttl
-                try:
-                    value = await loader()
-                    self.values[key] = (value, expiry)
-                    return value
-                finally:
-                    self.pending.pop(key, None)
-            self.pending[key] = asyncio.create_task(load())
-        return await self.pending[key]
+        cached = self.values.get(key, _MISSING)
+        if cached is not _MISSING:
+            value, expiry = cached
+            if self.clock() < expiry:
+                return value
+        task = self.pending.get(key)
+        if task is None:
+            task = asyncio.create_task(self._load(key, loader))
+            self.pending[key] = task
+        # shield(): cancelling *this* waiter cancels only the shield wrapper,
+        # never the shared loader task other callers depend on.
+        ok, payload = await asyncio.shield(task)
+        if ok:
+            return payload
+        raise payload
+
+    async def _load(self, key, loader):
+        task = asyncio.current_task()
+        try:
+            value = await loader()
+        except asyncio.CancelledError:
+            self._detach(key, task)
+            raise
+        except BaseException as exc:  # failures are never cached
+            self._detach(key, task)
+            return (False, exc)
+        expiry = self.clock() + self.ttl  # TTL starts at successful completion
+        if self.pending.get(key) is task:
+            # Still cache-owned: publish under the current generation. A load
+            # detached by clear() (or superseded by a newer one) never touches
+            # values nor removes a newer pending task.
+            self.pending.pop(key, None)
+            self.values[key] = (value, expiry)
+        return (True, value)
+
+    def _detach(self, key, task):
+        if self.pending.get(key) is task:
+            del self.pending[key]
 
     def clear(self):
         self.values.clear()
+        self.pending.clear()
diff --git a/tests/test_regressions.py b/tests/test_regressions.py
