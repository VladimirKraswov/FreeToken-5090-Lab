@@ -1,13 +1,89 @@
+// Dependency-free model layer for pointer-driven gesture history.
+// Documents are JSON-serializable values; every boundary is defensively copied.
+
+function deepCopy(value) {
+  if (Array.isArray(value)) return value.map(deepCopy);
+  if (value !== null && typeof value === 'object') {
+    const out = {};
+    for (const key of Object.keys(value)) out[key] = deepCopy(value[key]);
+    return out;
+  }
+  return value;
+}
+
+// Structural equality: object key order is irrelevant, array order is not,
+// a missing key is different from a key holding null.
+function structurallyEqual(a, b) {
+  if (a === b) return true;
+  if (typeof a !== 'object' || typeof b !== 'object' || a === null || b === null) return false;
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  if (Array.isArray(a)) {
+    if (a.length !== b.length) return false;
+    return a.every((item, i) => structurallyEqual(item, b[i]));
+  }
+  const aKeys = Object.keys(a);
+  if (aKeys.length !== Object.keys(b).length) return false;
+  return aKeys.every(
+    (key) => Object.prototype.hasOwnProperty.call(b, key) && structurallyEqual(a[key], b[key])
+  );
+}
+
+function owns(active, pointerId) {
+  return active !== null && active.pointerId === pointerId;
+}
+
 export class GestureHistory {
-  constructor(initial) { this.current = initial; this.past = []; this.future = []; this.active = null; }
-  get state() { return this.current; }
-  begin(pointerId) { this.active = { pointerId, start: this.current }; return true; }
-  update(pointerId, next) { if (!this.active) return false; this.current = next; return true; }
+  constructor(initial) {
+    this.current = deepCopy(initial);
+    this.past = [];
+    this.future = [];
+    this.active = null;
+  }
+
+  get state() {
+    return deepCopy(this.current);
+  }
+
+  begin(pointerId) {
+    if (this.active !== null) return false;
+    this.active = { pointerId, start: deepCopy(this.current) };
+    return true;
+  }
+
+  update(pointerId, next) {
+    if (!owns(this.active, pointerId)) return false;
+    this.current = deepCopy(next);
+    return true;
+  }
+
   commit(pointerId) {
-    if (!this.active) return false;
-    this.past.push(this.active.start); this.future = []; this.active = null; return true;
+    if (!owns(this.active, pointerId)) return false;
+    if (!structurallyEqual(this.active.start, this.current)) {
+      this.past.push(this.active.start);
+      this.future = [];
+    }
+    this.active = null;
+    return true;
+  }
+
+  cancel(pointerId) {
+    if (!owns(this.active, pointerId)) return false;
+    this.current = deepCopy(this.active.start);
+    this.active = null;
+    return true;
+  }
+
+  undo() {
+    if (this.active !== null || this.past.length === 0) return false;
+    this.future.push(this.current);
+    this.current = this.past.pop();
+    return true;
+  }
+
+  redo() {
+    if (this.active !== null || this.future.length === 0) return false;
+    this.past.push(this.current);
+    this.current = this.future.pop();
+    return true;
   }
-  cancel(pointerId) { if (!this.active) return false; this.current = this.active.start; this.active = null; return true; }
