{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-qwen-next/qwen38-flash-next",
  "small_model": "local-qwen-next/qwen38-flash-next",
  "default_agent": "qwen-build",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "preserve_recent_tokens": 16000,
    "reserved": 32768
  },
  "lsp": true,
  "formatter": true,
  "snapshot": true,
  "provider": {
    "local-qwen-next": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.8 Flash Next local",
      "options": {
        "baseURL": "http://<inference-host>:1919/v1",
        "apiKey": "local",
        "headers": {}
      },
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen3.8 Flash Next NVFP4 (RTX 5090)",
          "family": "qwen",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384,
            "input": 114688
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          },
          "options": {
            "reasoningEffort": "medium",
            "chat_template_kwargs": {
              "enable_thinking": true,
              "preserve_thinking": true
            },
            "top_k": 20,
            "min_p": 0.0,
            "repetition_penalty": 1.0,
            "presence_penalty": 0.0
          }
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/instructions/qwen-coding.md"
  ]
}
